# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Leave empty to run in demo mode on sample data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# How people sign in: "email" (free, works out of the box) or "phone"
# (needs an SMS provider configured in Supabase → Authentication → Providers → Phone).
VITE_AUTH_METHOD=email
